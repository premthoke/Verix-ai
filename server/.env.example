# Server Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file.

PORT=5000

# PostgreSQL — Required for Brick 1 (persistent history)
# Get this from Neon (https://neon.tech), Supabase, or Railway.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Ethereum / Blockchain
RPC_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=

# Sightengine AI Detection API
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
