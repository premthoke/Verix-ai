# Server Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file.

PORT=5000

# PostgreSQL — Required (Brick 1: persistent history, Brick 2: users)
# Get this from Neon (https://neon.tech), Supabase, or Railway.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# JWT Authentication — Required (Brick 2)
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Ethereum / Blockchain
RPC_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=

# Sightengine AI Detection API
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
