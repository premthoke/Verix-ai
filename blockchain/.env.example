# Blockchain deployment environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# Sepolia RPC endpoint — get one free from:
#   https://www.infura.io
#   https://www.alchemy.com
#   https://www.quicknode.com
SEPOLIA_RPC_URL=

# The private key of the wallet that will:
#   1. Deploy the contract (becomes the Ownable owner)
#   2. Sign all storeMedia() transactions from the backend
# Must match PRIVATE_KEY in server/.env and on Render.
# With or without the 0x prefix — both are handled.
PRIVATE_KEY=
